<group name="local,">

  <!-- Cron files added or modified-->
  <rule id="100506" level="10">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">^/etc/cron|^/var/spool/cron</field>
    <description>Linux cron persistence file changed: $(file)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>linux,persistence,</group>
  </rule>

</group>
