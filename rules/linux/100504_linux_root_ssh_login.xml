<group name="local,">

  <!-- Root login over SSH -->
  <rule id="100504" level="12">
    <if_sid>5715</if_sid>
    <user>^root$</user>
    <description>Linux root SSH login detected</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>linux,authentication_success,privilege_escalation,</group>
  </rule>

</group>
