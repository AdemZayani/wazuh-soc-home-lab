<group name="local,">

  <!-- SSH brute force, valid users-->
  <rule id="100503" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force: multiple failed passwords from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>linux,authentication_failed,ssh_bruteforce,</group>
  </rule>

</group>
